<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="margin:0;padding:0;background:#07070d;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#e5e7eb;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#07070d;">
      <tr>
        <td align="center" style="padding:40px 16px;">
          <table role="presentation" width="500" cellpadding="0" cellspacing="0" style="max-width:500px;width:100%;background:#0b0b16;border:1px solid #1f1f2e;border-radius:16px;">
            <tr>
              <td style="padding:28px 32px;">
                <p style="margin:0 0 12px;font-size:20px;font-weight:800;color:#ffffff;">
                  <span style="color:#818cf8;">Next</span> — confirm your email
                </p>
                <p style="margin:0;font-size:14px;line-height:1.6;color:#d1d5db;">
                  Confirm your subscription to start receiving the daily AI briefing and Business Idea of the Day.
                </p>
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:20px;">
                  <tr>
                    <td>
                      <a href="<%= confirm_url %>" style="display:inline-block;padding:11px 22px;background:linear-gradient(90deg,#10b981,#14b8a6);color:#06281c;font-size:13px;font-weight:700;text-decoration:none;border-radius:10px;">
                        Yes, subscribe me
                      </a>
                    </td>
                  </tr>
                </table>
                <p style="margin:20px 0 0;font-size:12px;color:#9ca3af;line-height:1.7;">
                  If you didn't request this, you can safely ignore this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>