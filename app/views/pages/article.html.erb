<% content_for :title, "#{@article.title} — Next AI News" %>
<% content_for :description, truncate(@article.summary || @article.title, length: 160) %>

<!-- Article Header -->
<article class="max-w-4xl mx-auto">
  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to "Home", root_path, class: "hover:text-indigo-400 transition-colors" %>
    <span>/</span>
    <%= link_to @article.category.name, category_path(@article.category.slug), class: "hover:text-indigo-400 transition-colors", style: "color: #{@article.category.color}" %>
    <span>/</span>
    <span>Article</span>
  </div>

  <!-- Category badge -->
  <span class="inline-block px-3 py-1 rounded-lg text-xs font-semibold mb-4" style="background: <%= @article.category.color %>22; color: <%= @article.category.color %>; border: 1px solid <%= @article.category.color %>33"><%= @article.category.name %></span>

  <!-- Title -->
  <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
    <%= @article.title %>
  </h1>

  <!-- Meta -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-8 border-b border-white/5">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500/40 to-purple-500/40 flex items-center justify-center">
        <span class="text-sm font-bold text-indigo-300"><%= @article.source.name.first(2).upcase %></span>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-300"><%= @article.source.name %></p>
        <p class="text-xs text-gray-500">
          <% if @article.published_at %>
            <%= @article.published_at.strftime("%B %d, %Y at %I:%M %p") %>
          <% end %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-xs text-gray-500 flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <%= @article.view_count %> views
      </span>
      <%= link_to "Read Original ↗", @article.url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-sm text-gray-300 hover:text-white hover:border-indigo-500/40 hover:bg-indigo-500/10 transition-all" %>
    </div>
  </div>

  <!-- Hero image -->
  <% if @article.image_url.present? %>
    <div class="rounded-3xl overflow-hidden mb-8 border border-white/5">
      <img src="<%= @article.image_url %>" alt="<%= @article.title %>" class="w-full max-h-[500px] object-cover" onerror="this.style.display='none'">
    </div>
  <% end %>

  <!-- Summary highlight -->
  <% if @article.summary.present? %>
    <div class="rounded-2xl border border-indigo-500/20 bg-indigo-500/5 p-6 mb-8">
      <p class="text-indigo-200/90 text-lg leading-relaxed font-medium">📌 <%= @article.summary %></p>
    </div>
  <% end %>

  <!-- Full content -->
  <div class="prose prose-invert prose-lg max-w-none">
    <% if @article.content.present? %>
      <%= simple_format @article.content, class: "text-gray-300 leading-relaxed text-lg" %>
    <% elsif @article.summary.present? %>
      <p class="text-gray-300 leading-relaxed text-lg"><%= @article.summary %></p>
    <% else %>
      <p class="text-gray-300 leading-relaxed text-lg">Full content available at the source.</p>
    <% end %>
  </div>

  <!-- Source CTA -->
  <div class="mt-8 p-6 rounded-2xl border border-white/5 bg-white/[0.02]">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <p class="text-sm text-gray-400 mb-1">Read the full article at</p>
        <p class="font-semibold text-white"><%= @article.source.name %></p>
      </div>
      <%= link_to "Visit Source ↗", @article.url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white font-semibold transition-all hover:scale-[1.02] shadow-lg shadow-indigo-500/25" %>
    </div>
  </div>

  <!-- Related articles -->
  <% if @related_articles.any? %>
    <div class="mt-14">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
        <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
        More in <%= @article.category.name %>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <% @related_articles.each do |related| %>
          <%= render "shared/article_card", article: related %>
        <% end %>
      </div>
    </div>
  <% end %>
</article>