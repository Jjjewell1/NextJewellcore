<% content_for :title, "#{@idea&.title || 'Business Ideas'} — Next: AI for Money" %>
<% content_for :description, "A fresh, feasible, low-cost business idea every day — crafted from today's hottest AI trends and news." %>

<!-- Hero: Business Idea of the Day -->
<section class="relative overflow-hidden rounded-3xl border border-emerald-500/20 bg-gradient-to-br from-emerald-600/15 via-teal-500/10 to-transparent p-8 sm:p-12 mb-10">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(16,185,129,0.12),transparent_50%)] pointer-events-none"></div>

  <div class="relative z-10">
    <div class="flex items-center gap-2 mb-6">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-xs font-semibold text-emerald-300">
        💡 Business Idea of the Day
      </span>
      <% if @idea && @idea.idea_date %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/10 text-xs font-semibold text-gray-400">
          <%= @idea.idea_date.strftime("%B %d, %Y") %>
        </span>
      <% end %>
    </div>

    <% if @idea %>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
        <%= @idea.title %>
      </h1>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 text-xs font-semibold">
          🎯 <span><%= @idea.difficulty_level %> Friendly</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] text-gray-300 border border-white/10 text-xs font-semibold">
          📊 <span><%= @idea.category %></span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 text-amber-300 border border-amber-500/20 text-xs font-semibold">
          💰 <span><%= @idea.expected_income %></span>
        </span>
      </div>

      <p class="text-gray-300 text-lg sm:text-xl leading-relaxed max-w-3xl">
        <%= @idea.description %>
      </p>

      <!-- How to start -->
      <div class="mt-8 max-w-3xl">
        <h2 class="text-lg font-bold text-emerald-300 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          How to Get Started
        </h2>
        <div class="rounded-2xl border border-emerald-500/15 bg-[#0a0a14]/60 p-6">
          <% @idea.how_to_start.to_s.split("\n").each do |line| %>
            <% if line =~ /^\d+\./ %>
              <div class="flex items-start gap-3 mb-3">
                <span class="w-6 h-6 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5"><%= line.match(/^\d+/)[0] %></span>
                <p class="text-gray-300 text-sm"><%= line.sub(/^\d+\.\s*/, "") %></p>
              </div>
            <% elsif line.strip.present? %>
              <p class="text-gray-400 text-sm pl-9 mb-2">💡 <%= line %></p>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Tools & Income -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8 max-w-3xl">
        <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-6">
          <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-3 flex items-center gap-2">🛠️ Tools Needed</h3>
          <p class="text-sm text-gray-400 leading-relaxed"><%= @idea.tools_needed %></p>
        </div>
        <div class="rounded-2xl border border-amber-500/15 bg-amber-500/[0.03] p-6">
          <h3 class="text-sm font-bold text-amber-300 uppercase tracking-wider mb-3 flex items-center gap-2">💵 Expected Income</h3>
          <p class="text-sm text-gray-400 leading-relaxed"><%= @idea.expected_income %></p>
        </div>
      </div>

      <!-- Source articles -->
      <% if @idea.source_articles.any? %>
        <div class="mt-10 max-w-3xl">
          <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-4">This idea was inspired by recent AI news</h3>
          <div class="space-y-2">
            <% @idea.source_articles.first(5).each do |article| %>
              <%= link_to article_path(article), class: "flex items-center justify-between p-3 rounded-xl bg-white/[0.02] border border-white/5 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all group" do %>
                <span class="flex items-center gap-3 min-w-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 flex-shrink-0"></span>
                  <span class="text-sm text-gray-300 group-hover:text-white truncate"><%= article.title %></span>
                </span>
                <span class="text-xs text-gray-600 flex-shrink-0 ml-3"><%= article.source.name %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
        Refining today's idea...
      </h1>
      <p class="text-gray-300 text-lg max-w-2xl">
        We're analyzing the latest AI news to craft a fresh business idea. Check back after our next hourly scrape!
      </p>
    <% end %>
  </div>
</section>

<!-- Past ideas -->
<% if @recent_ideas.present? %>
  <div class="mt-14">
    <h2 class="text-2xl font-bold text-white mb-6">Previous Ideas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @recent_ideas.each do |idea| %>
        <div class="rounded-3xl border border-white/5 bg-white/[0.02] p-6 hover:border-emerald-500/30 hover:bg-emerald-500/[0.03] transition-all group">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs text-gray-500"><%= idea.idea_date.strftime("%b %d") %></span>
            <span class="text-xs px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/20"><%= idea.difficulty_level %></span>
          </div>
          <h3 class="text-base font-semibold text-white group-hover:text-emerald-300 transition-colors line-clamp-2 mb-2"><%= idea.title %></h3>
          <p class="text-sm text-gray-400 line-clamp-3 mb-4"><%= truncate(idea.description, length: 120) %></p>
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-600">💸 <%= idea.expected_income %></span>
            <%= link_to "Read →", business_idea_path(date: idea.idea_date), class: "text-xs text-emerald-400 hover:text-emerald-300" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="mt-14">
  <a href="<%= root_path %>" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    Back to AI News
  </a>
</div>