<% content_for :title, "#{@query.present? ? "Search: #{@query}" : "Search"} — Next AI News" %>
<% content_for :description, "Search across every AI news article we've scraped." %>

<!-- Search header -->
<section class="mb-10">
  <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-3">Search</h1>
  <form action="<%= search_path %>" method="get" class="max-w-2xl mb-4">
    <div class="relative">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input type="search" name="q" value="<%= @query %>" placeholder="Search across all AI news..." class="w-full pl-12 pr-4 py-3.5 bg-white/[0.06] border border-white/10 rounded-2xl text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500/50 transition-all">
    </div>
  </form>

  <% if @query.present? %>
    <p class="text-gray-400 text-sm">
      <span class="text-white font-semibold"><%= @articles.size %></span> results for
      <span class="text-indigo-300 font-medium">"<%= @query %>"</span>
    </p>
  <% end %>
</section>

<!-- Search results -->
<% if @articles.any? %>
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @articles.each do |article| %>
      <%= render "shared/article_card", article: article %>
    <% end %>
  </section>

  <% if @articles.size >= Pagination::PAGE_SIZE %>
    <div class="flex justify-center mt-10">
      <%= link_to "Load More", search_path(q: @query, page: params[:page].to_i + 1), class: "px-6 py-3 rounded-2xl bg-white/[0.04] border border-white/10 text-gray-300 hover:text-white hover:border-indigo-500/40 hover:bg-indigo-500/10 transition-all" %>
    </div>
  <% end %>
<% elsif @query.present? %>
  <div class="rounded-3xl border border-white/5 bg-white/[0.02] p-16 text-center">
    <p class="text-4xl mb-4">🔍</p>
    <h3 class="text-xl font-bold text-white mb-2">No matches for "<%= @query %>"</h3>
    <p class="text-gray-400 text-sm max-w-md mx-auto">Try a different keyword, or browse by category from the home page.</p>
  </div>
<% else %>
  <div class="rounded-3xl border border-white/5 bg-white/[0.02] p-16 text-center">
    <p class="text-4xl mb-4">🔎</p>
    <h3 class="text-xl font-bold text-white mb-2">Search all AI news</h3>
    <p class="text-gray-400 text-sm max-w-md mx-auto">Search by topic, model name, company, or trend across every article we've scraped.</p>
  </div>
<% end %>